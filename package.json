{
  "name": "arran-dnd",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "create-user": "npm run create-user -w server --",
    "test": "npm run test -w client && npm run test -w server",
    "seed-dev": "npm run seed-dev -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "heic-convert": "^2.1.0",
    "sharp": "^0.34.5"
  }
}
